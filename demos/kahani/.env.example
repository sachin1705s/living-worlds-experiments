# Server-only credentials. Never put real values in client code or commit .env.
REACTOR_API_KEY=rk_your_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
# Director model. Defaults to gemini-2.5-flash.
# GEMINI_DIRECTOR_MODEL=gemini-2.5-flash
# Narrator voice. Defaults to Aoede, a warm storyteller.
# GEMINI_TTS_VOICE=Aoede
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# Optional provider overrides for local development.
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# REACTOR_COORDINATOR_URL=

# For local Reactor runtimes only (skips JWT exchange).
# VITE_HO_LOCAL_RUNTIME=
# VITE_COORDINATOR_URL=
